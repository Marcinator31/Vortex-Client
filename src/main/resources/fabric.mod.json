{
	"schemaVersion": 1,
	"id": "vortexclient",
	"version": "${version}",

	"name": "Vortex Client",
	"description": "Vortex Client -- Fabric-Client mit HUD-Modulen, ESP, Waypoint-System, Skin-Garderobe und Performance-Werkzeugen.",
	"authors": [],
	"contact": {},

	"license": "MIT",
	"icon": "assets/vortexclient/icon/icon.png",

	"environment": "client",

	"entrypoints": {
		"main": [
			"com.vortex.client.VortexClient"
		],
		"client": [
			"com.vortex.client.VortexClientMod"
		]
	},

	"mixins": [
		{
			"config": "vortexclient.client.mixins.json",
			"environment": "client"
		}
	],

	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},

	"suggests": {
		"sodium": "*",
		"lithium": "*"
	}
}
